# Plantilla de variables de entorno — copia este archivo a .env.local
# y rellena los valores reales. .env.local NUNCA se sube a git (está en
# .gitignore). En producción (Vercel), estas mismas variables se configuran
# en: Project Settings → Environment Variables.

# --- Donaciones: PayPal ---
# IDs de botón "Donate" de PayPal. Se generan en paypal.com → Herramientas
# para vendedores → Botones de PayPal. Deja la línea comentada/vacía si
# ese método de donación aún no está activo: la sección se oculta sola.
# PAYPAL_BUTTON_ID_ALIMENTOS=
# PAYPAL_BUTTON_ID_BIOSEGURIDAD=
# PAYPAL_BUTTON_ID_RECURSOS=

# --- Donaciones: Transferencia bancaria ---
# DONACIONES_BANCO_NOMBRE=
# DONACIONES_BANCO_NUMERO=
# DONACIONES_BANCO_TITULAR=
# DONACIONES_BANCO_TIPO=

# --- Donaciones: Billetera digital (Nequi, Daviplata, etc) ---
# DONACIONES_BILLETERA_NUMERO=
# DONACIONES_BILLETERA_TIPO=

# --- Email del formulario de contacto (si se conecta Resend) ---
# RESEND_API_KEY=
